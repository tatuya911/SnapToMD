<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- APIキーなどの機密情報を含むSharedPreferencesをクラウドバックアップから除外 -->
        <exclude domain="sharedpref" path="app_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- 端末間直接転送時もAPIキーを含む設定を除外 -->
        <exclude domain="sharedpref" path="app_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
